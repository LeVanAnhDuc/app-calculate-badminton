# Mọi biến VITE_* đều CÔNG KHAI — Vite inline chúng vào bundle lúc build.
# Đừng bao giờ đặt bí mật ở đây. Prod (GitHub Pages) lấy các giá trị này từ
# Repository variables (Settings → Secrets and variables → Actions → Variables),
# xem .github/workflows/deploy.yml.

# ── Đường dẫn gốc của app ────────────────────────────────────────────────
# Local: "/". GitHub Pages: "/web-app-calculate-badminton/". Phải có "/" ở cuối —
# router basename, scope của service worker và redirect_uri đều dựa vào nó.
VITE_BASE_PATH=/

# ── Ducker ID SSO (OIDC Authorization Code + PKCE) ───────────────────────
# Badminton là public client (không backend) nên KHÔNG có client_secret.
# Thiếu ISSUER hoặc CLIENT_ID thì nút đăng nhập tự ẩn, app chạy bình thường.

# Gốc của Ducker ID (nơi có /oauth/authorize, /oauth/token, /oauth/userinfo).
VITE_DUCKER_ISSUER=http://localhost:3000
# client_id của app "badminton" đã đăng ký trong admin console của Ducker ID.
# redirect_uri đã đăng ký ở đó phải khớp TUYỆT ĐỐI với origin + VITE_BASE_PATH
# (local: http://localhost:5173/).
VITE_DUCKER_CLIENT_ID=
# Scope xin khi đăng nhập — phải nằm trong allowed scopes của client.
VITE_DUCKER_SCOPE=openid profile email
# Trang hồ sơ trên Ducker ID mà /account liên kết tới (tương đối với ISSUER).
VITE_DUCKER_PROFILE_PATH=/profile
